# Isolated auth mockup — port 8002.
#
# THIS FILE IS SEPARATE FROM THE REPO-ROOT .env ON PURPOSE. The demo stack's
# .env holds OpenRouter keys and the LiteLLM master key; nothing here reads it
# and nothing here writes to it.
#
# Get these from https://console.cloud.google.com/apis/credentials
#   Create Credentials -> OAuth client ID -> Web application
#   Authorised redirect URI MUST be exactly:
#     http://localhost:8002/api/auth/callback
#   (Google matches this string exactly - a trailing slash breaks it.)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Defaults to http://localhost:<port>/api/auth/callback
# GOOGLE_REDIRECT_URL=http://localhost:8002/api/auth/callback

# Optional. Defaults to 8002. Do not use 3000/8000/8001/8080/4000/5432 -
# those belong to the demo stack.
# AUTH_MOCKUP_PORT=8002

# Optional logging, e.g. RUST_LOG=debug
# RUST_LOG=info
